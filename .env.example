# Local development uses the bounded in-memory limiter.
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_MAX_REQUESTS=30

# Public multi-instance deployment: use a trusted proxy and shared Upstash limiter.
# TRUST_PROXY=true
# RATE_LIMIT_BACKEND=upstash
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-me

# Opt-in live provider validation only; never commit real keys.
# RUN_LIVE_PROVIDER_TESTS=true
# SUSAN_TEST_PROVIDERS=openai,google
# OPENAI_API_KEY=replace-me
# GOOGLE_API_KEY=replace-me
# DEEPSEEK_API_KEY=replace-me
# ANTHROPIC_API_KEY=replace-me
# HUGGINGFACE_API_KEY=replace-me
# QWEN_API_KEY=replace-me
# KIMI_API_KEY=replace-me
# SARVAM_API_KEY=replace-me
# OPENROUTER_API_KEY=replace-me
